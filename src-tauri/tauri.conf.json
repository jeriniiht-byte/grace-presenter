{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "grace-presenter",
  "version": "0.1.0",
  "identifier": "com.gracepresenter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "grace-presenter",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/backgrounds/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxODU2NDU0RDdEQ0YwNDUKUldSRjhOelhWR1NGUVNKamRuMUpJWmNKdVpEdEsvTkVNL1FwZHFFQUJSTFcwdTVJQStLNGM3bnoK",
      "endpoints": [
        "https://github.com/jeriniiht-byte/grace-presenter/releases/latest/download/latest.json"
      ]
    }
  }
}
